# Use the Discord Bot Token, not the Application ID, Client ID, or Public Key.
DISCORD_BOT_TOKEN=put_your_discord_bot_token_here
DISCORD_NOTIFICATION_CHANNEL_ID=put_the_discord_channel_id_here
DISCORD_APPLICATIONS_CHANNEL_ID=put_the_applications_channel_id_here
DISCORD_ACCEPTED_ROLE_ID=put_the_accepted_partner_role_id_here

# Optional: needed only if you want Twitch live checks.
# This is one Twitch app for your bot, not one ID per streamer.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: needed for YouTube live checks after a YouTube creator is accepted.
YOUTUBE_API_KEY=

# Optional: TikTok has no official public live-status API. If you use a third-party
# service, point this to an endpoint that accepts ?handle=username and returns JSON.
TIKTOK_LIVE_CHECK_URL=
TIKTOK_LIVE_CHECK_API_KEY=

# Platform ping IDs. Paste the Discord role ID for each platform.
TWITCH_PING_ROLE_ID=
KICK_PING_ROLE_ID=
YOUTUBE_PING_ROLE_ID=
TIKTOK_PING_ROLE_ID=

# Optional backup: role IDs to ping for platforms without a platform ping ID.
DISCORD_LIVE_ROLE_IDS=

# Optional: comma-separated Twitch handles to add on first startup.
TWITCH_CHANNELS=

# Optional settings.
POLL_INTERVAL_SECONDS=60
DATA_DIR=./data
PORT=3000
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:3000
MESSAGE_TEMPLATE={displayName} is live on {platformName}: {url}
